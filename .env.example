# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Clerk — get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase — get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Storage bucket name (default: listing-media)
NEXT_PUBLIC_SUPABASE_LISTING_BUCKET=listing-media

# Paystack — get from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Sentry — get from https://sentry.io
# The DSN is public by design: it ships in the browser bundle either way.
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Build-time only. Uploads source maps. THE BUILD SUCCEEDS WITHOUT IT.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Which environment this is. GATES SENTRY TRANSMISSION — only "preview" and
# "production" transmit. Anything else, including unset and "test", stays local
# and loud in the terminal. Do not set this to "production" on a laptop.
NEXT_PUBLIC_APP_ENV=development

# Optional. Ties an error to a deploy. Falls back to VERCEL_GIT_COMMIT_SHA and
# then to "unknown" — a missing release is visible in Sentry rather than
# silently absent.
NEXT_PUBLIC_RELEASE=

# Optional. DEBUG|INFO|WARN|ERROR|FATAL. Defaults to INFO in production.
LOG_LEVEL=

# Monitoring — bearer secret for GET /api/monitoring/absence.
# Generate with: openssl rand -base64 32
MONITORING_SECRET=
# Seconds. Oldest queued job age that counts as the drain having stopped.
JOB_QUEUE_MAX_AGE_SECONDS=900

# -----------------------------------------------------------------------------
# TWO SENTRY ALERT RULES MUST BE CREATED BY HAND.
#
# Code emits the events; Sentry notifies nobody until the rules exist. A metric
# nobody sees is the same as no metric.
#
#   alert.kind = absence          -> the job drain has stopped
#   alert.kind = view-unresolved  -> listing views are not being recorded
#
# See docs/operations/observability-runbook.md.
# -----------------------------------------------------------------------------

# Dev auth — enable for local development only, never in production
ENABLE_DEV_AUTH=false
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

# Local dev personas — used by scripts/setup-clerk-personas.mjs
CLERK_DEV_PERSONA_PASSWORD=generate_a_strong_value

# Job queue drain (ADR-032). Required — the route fails closed without it, and
# it executes with the service-role key. Generate with: openssl rand -base64 32
JOBS_DRAIN_SECRET=generate_a_strong_value

# ---------------------------------------------------------------------------
# Configuration that is NOT in this repository
#
# The Clerk session token must carry a `role` claim set to "authenticated".
# It is configured in the Clerk Dashboard under session token customization,
# and it exists nowhere in this codebase.
#
# Without it, Supabase does not assume the authenticated Postgres role, every
# RLS policy evaluates against no identity, and every authenticated query
# returns an empty array. That failure is silent — it looks exactly like a
# correctly-denying policy, not like a misconfiguration.
#
# Provisioning a new Clerk instance therefore takes two steps, not one:
#   1. node scripts/setup-clerk-personas.mjs
#   2. add the role claim in the Clerk Dashboard
# ---------------------------------------------------------------------------
